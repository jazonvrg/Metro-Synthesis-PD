[11/06 13:45:59     48s] @file 87: set PAD_POWER_SLOTS {
[11/06 13:45:59     48s]   {bottom 0 pad_vdd_b PADVDD}
[11/06 13:45:59     48s]   {bottom 1 pad_vss_b PADVSS}
