[11/06 14:05:51    106s] @file 87: set PAD_POWER_SLOTS {
[11/06 14:05:51    106s]   {bottom 0 pad_vdd_b PADVDD}
[11/06 14:05:51    106s]   {bottom 1 pad_vss_b PADVSS}
[11/06 14:05:51    106s]   {top 14 pad_vdd_t PADVDD}
[11/06 14:05:51    106s]   {top 15 pad_vss_t PADVSS}
[11/06 14:05:51    106s] }
[11/06 14:05:51    106s] @file 93:
[11/06 14:05:51    106s] @file 94: # Tra ve {x y orient} (goc duoi-trai cua bbox sau khi xoay). dw, dh = kich thuoc die.
[11/06 14:05:51    106s] @file 95: # Pad thiet ke cho canh duoi (R0): phia core o +y. Canh tren R180, trai R270, phai R90.
[11/06 14:05:51    106s] @file 96: proc pad_xy {side idx dw dh} {
[11/06 14:05:51    106s]     global PAD_W PAD_H PAD_X0 PAD_Y0
[11/06 14:05:51    106s]     switch -- $side {
[11/06 14:05:51    106s]         bottom { return [list [expr {$PAD_X0 + $PAD_W * $idx}] 0.0 r0] }
[11/06 14:05:51    106s]         top    { return [list [expr {$PAD_X0 + $PAD_W * $idx}] [format %.3f [expr {$dh - $PAD_H}]] r180] }
[11/06 14:05:51    106s]         left   { return [list 0.0 [expr {$PAD_Y0 + $PAD_W * $idx}] r270] }
[11/06 14:05:51    106s]         right  { return [list [format %.3f [expr {$dw - $PAD_H}]] [expr {$PAD_Y0 + $PAD_W * $idx}] r90] }
[11/06 14:05:51    106s]     }
[11/06 14:05:51    106s]     error "pad_xy: side khong hop le: $side"
[11/06 14:05:51    106s] }
[11/06 14:05:51    106s] #@ End verbose source pad_slots.tcl
[11/06 14:05:51    106s] @file 4: set bb [join [get_db current_design .bbox]]
[11/06 14:05:51    106s] @file 5: lassign $bb dx0 dy0 dw dh
[11/06 14:05:51    106s] @file 6:
[11/06 14:05:51    106s] @file 7: foreach s $PAD_POWER_SLOTS {
[11/06 14:05:51    106s]     lassign $s side idx name cell
[11/06 14:05:51    106s]     lassign [pad_xy $side $idx $dw $dh] x y orient
[11/06 14:05:51    106s]     create_inst -cell $cell -inst $name -location [list $x $y] -orient $orient -status fixed
[11/06 14:05:51    106s]     puts "PH_run06 power pad $name ($cell) tai $x $y $orient"
[11/06 14:05:51    106s] }
