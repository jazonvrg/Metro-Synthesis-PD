[11/06 13:45:59     48s] @file 93:
[11/06 13:45:59     48s] @file 94: # Tra ve {x y orient} (goc duoi-trai cua bbox sau khi xoay). dw, dh = kich thuoc die.
[11/06 13:45:59     48s] @file 95: # Pad thiet ke cho canh duoi (R0): phia core o +y. Canh tren R180, trai R270, phai R90.
[11/06 13:45:59     48s] @file 96: proc pad_xy {side idx dw dh} {
[11/06 13:45:59     48s]     global PAD_W PAD_H PAD_X0 PAD_Y0
[11/06 13:45:59     48s]     switch -- $side {
[11/06 13:45:59     48s]         bottom { return [list [expr {$PAD_X0 + $PAD_W * $idx}] 0.0 r0] }
[11/06 13:45:59     48s]         top    { return [list [expr {$PAD_X0 + $PAD_W * $idx}] [format %.3f [expr {$dh - $PAD_H}]] r180] }
[11/06 13:45:59     48s]         left   { return [list 0.0 [expr {$PAD_Y0 + $PAD_W * $idx}] r270] }
[11/06 13:45:59     48s]         right  { return [list [format %.3f [expr {$dw - $PAD_H}]] [expr {$PAD_Y0 + $PAD_W * $idx}] r90] }
[11/06 13:45:59     48s]     }
[11/06 13:45:59     48s]     error "pad_xy: side khong hop le: $side"
[11/06 13:45:59     48s] }
[11/06 13:45:59     48s] #@ End verbose source pad_slots.tcl
[11/06 13:45:59     48s] @file 24: set n 0
[11/06 13:45:59     48s] @file 25: foreach s $PAD_SLOTS {
[11/06 13:45:59     48s]     lassign $s side idx name cell
[11/06 13:45:59     48s]     lassign [pad_xy $side $idx $dw $dh] x y orient
[11/06 13:45:59     48s]     set inst [get_db insts $name]
[11/06 13:45:59     48s]     if {$inst eq ""} { puts "**PH_run06 ERROR: khong thay instance $name"; continue }
[11/06 13:45:59     48s]     set_db $inst .location [list $x $y]
[11/06 13:45:59     48s]     set_db $inst .orient $orient
[11/06 13:45:59     48s]     set_db $inst .place_status fixed
[11/06 13:45:59     48s]     set_db $inst .dont_touch true
[11/06 13:45:59     48s]     incr n
[11/06 13:45:59     48s] }
[11/06 13:45:59     48s] @file 36: puts "PH_run06 pad da dat: $n / 78"
[11/06 13:45:59     48s] PH_run06 pad da dat: 78 / 78
